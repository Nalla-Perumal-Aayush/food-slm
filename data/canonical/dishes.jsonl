{"id": "dish:avial", "type": "dish", "schema_version": "2", "labels": ["Avial"], "content": {"summary": "A thick mixed-vegetable dish in a ground-coconut and curd (or raw-mango) gravy, finished with raw coconut oil and curry leaves. A staple of the Kerala sadya and eaten across Tamil Nadu and Kerala."}, "structure": {"category": "kootu", "cuisine_state": "kerala", "style": "sadya", "diet": {"vegetarian": true, "vegan": false, "contains_dairy": true, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}, "names": [{"lang": "ml", "native": "അവിയൽ", "transliteration": "aviyal"}, {"lang": "ta", "native": "அவியல்", "transliteration": "aviyal"}], "regions": ["region:kerala"], "primary_ingredients": ["ing:coconut", "ing:curd"]}, "provenance": {"source_ids": ["src:en-wikipedia-org-avial"], "transformations": ["extracted", "promoted:smoke-1-reviewed"], "acquired_on": "2026-09-03", "synthetic": false}, "quality": {"confidence": 0.9, "validation_status": "human_validated", "corroboration_count": 1, "notes": "extracted (qwen7b) from Wikipedia; human-reviewed and corrected (names, diet, category)"}, "version": {"revision": 1, "created_on": "2026-09-03", "updated_on": "2026-09-03", "status": "active"}}
{"id": "dish:chicken-chettinad", "type": "dish", "schema_version": "2", "labels": ["Chicken Chettinad", "Chettinad chicken", "Chettinad kozhi"], "content": {"summary": "A Chettinad-style Tamil Nadu chicken dish: chicken marinated in yogurt and turmeric, then cooked with a freshly ground masala paste of red chillies, kalpasi, coconut, poppy seeds, coriander, cumin, fennel, black pepper, groundnuts, onion and garlic. Known for a deep, dark, pepper-forward heat.", "serving_context": "Served hot, garnished with coriander leaves, with boiled rice or paratha."}, "structure": {"category": "non_veg_curry", "cuisine_state": "tamil_nadu", "style": "chettinad", "diet": {"vegetarian": false, "vegan": false, "contains_dairy": true, "contains_egg": false, "contains_seafood": false, "contains_poultry": true, "contains_red_meat": false}, "course": ["lunch", "dinner", "main"], "names": [{"lang": "ta", "native": "செட்டிநாடு கோழி", "transliteration": "chettinad kozhi", "primary": true}], "primary_ingredients": ["ing:chicken", "ing:kalpasi", "ing:poppy-seeds"], "typical_techniques": ["tech:dry-roast", "tech:wet-grind"]}, "quality": {"confidence": 0.85, "validation_status": "human_validated", "corroboration_count": 1, "notes": "qwen7b:accept; gemma9b:accept; corroboration=1"}, "provenance": {"source_ids": ["src:en-wikipedia-org-chicken-chettinad"], "transformations": ["extracted:claude-code", "promoted:seed-chettinad-chicken"], "acquired_on": "2026-09-08", "synthetic": false}, "version": {"revision": 1, "created_on": "2026-09-08", "updated_on": "2026-09-08", "status": "active"}}
{"id": "dish:dosa", "type": "dish", "schema_version": "2", "labels": ["Dosa", "Dosai", "Thosai"], "content": {"summary": "A thin, savoury crepe of fermented ground rice-and-black-gram batter, cooked on a hot greased griddle. A staple South Indian tiffin item, served hot with chutney and sambar. The Tamil Nadu style is softer and thicker; the thin, crisp version that spread across India was first made in Karnataka.", "serving_context": "Breakfast or evening tiffin, served hot and folded or rolled, with coconut chutney, sambar and idli podi."}, "structure": {"category": "tiffin", "cuisine_state": "pan_south", "diet": {"vegetarian": true, "vegan": true, "contains_dairy": false, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}, "course": ["breakfast", "tiffin"], "names": [{"lang": "ta", "native": "தோசை", "transliteration": "dosai", "primary": true}, {"lang": "kn", "native": "ದೋಸೆ", "transliteration": "dose"}, {"lang": "te", "native": "దోస", "transliteration": "dose"}, {"lang": "ml", "native": "ദോശ", "transliteration": "dosa"}], "primary_ingredients": ["ing:idli-rice", "ing:urad-dal-whole"], "typical_techniques": ["tech:wet-grind", "tech:ferment", "tech:griddle-cook"]}, "quality": {"confidence": 0.85, "validation_status": "human_validated", "corroboration_count": 1, "notes": "qwen7b:accept; gemma9b:accept; corroboration=1"}, "provenance": {"source_ids": ["src:en-wikipedia-org-dosa-food"], "transformations": ["extracted:claude-code", "promoted:seed-dosa"], "acquired_on": "2026-09-03", "synthetic": false}, "version": {"revision": 1, "created_on": "2026-09-03", "updated_on": "2026-09-03", "status": "active"}}
{"id": "dish:idli", "type": "dish", "schema_version": "2", "labels": ["Idli"], "content": {"summary": "A savoury steamed cake of fermented rice-and-urad-dal batter, the defining South Indian breakfast, eaten across Tamil Nadu, Karnataka, Andhra Pradesh and Kerala.", "serving_context": "Breakfast/tiffin, served hot with sambar and coconut chutney; often with medu vada or idli podi."}, "structure": {"category": "tiffin", "cuisine_state": "pan_south", "diet": {"vegetarian": true, "vegan": true, "contains_dairy": false, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}, "course": ["breakfast", "tiffin"], "names": [{"lang": "ta", "native": "இட்லி", "transliteration": "idli", "primary": true}, {"lang": "kn", "native": "ಇಡ್ಲಿ", "transliteration": "idli"}, {"lang": "te", "native": "ఇడ్లీ", "transliteration": "idli"}, {"lang": "ml", "native": "ഇഡ്ഡലി", "transliteration": "idli"}], "primary_ingredients": ["ing:urad-dal-whole", "ing:idli-rice"], "typical_techniques": ["tech:wet-grind", "tech:ferment", "tech:steam"]}, "quality": {"confidence": 0.85, "validation_status": "human_validated", "corroboration_count": 1, "notes": "qwen7b:accept; gemma9b:accept; corroboration=1"}, "provenance": {"source_ids": ["src:en-wikipedia-org-idli"], "transformations": ["extracted:claude-code", "promoted:seed-idli-rasam"], "acquired_on": "2026-09-03", "synthetic": false}, "version": {"revision": 1, "created_on": "2026-09-03", "updated_on": "2026-09-03", "status": "active"}}
{"id": "dish:malabar-matthi-curry", "type": "dish", "schema_version": "2", "labels": ["Malabar matthi curry", "Meen curry", "Kerala fish curry", "Mathi curry"], "content": {"summary": "A traditional Kerala fish curry: fish semi-stewed in a thin, tangy, chilli-red sauce soured with kudampuli (Malabar tamarind). Sardines are the classic fish; mackerel, kingfish or pomfret also work. No coconut milk in this style — the character comes from kudampuli, chilli and coconut oil.", "serving_context": "Served with rice; tastes better the day after it is made.", "description": "Sliced shallots, garlic, ginger, slit green chillies, turmeric, chilli, salt, curry leaves, coconut oil and pieces of kudampuli are mixed with water and brought to the boil, then the fish is added one piece at a time and semi-stewed."}, "structure": {"category": "seafood_dish", "cuisine_state": "kerala", "style": "malabar", "diet": {"vegetarian": false, "vegan": false, "contains_dairy": false, "contains_egg": false, "contains_seafood": true, "contains_poultry": false, "contains_red_meat": false}, "course": ["lunch", "dinner", "main"], "names": [{"lang": "ml", "native": "മീൻ കറി", "transliteration": "meen curry", "primary": true}], "primary_ingredients": ["ing:sardine", "ing:kudampuli", "ing:coconut-oil"], "typical_techniques": ["tech:gentle-simmer", "tech:tadka"]}, "quality": {"confidence": 0.85, "validation_status": "human_validated", "corroboration_count": 1, "notes": "qwen7b:accept; gemma9b:accept; corroboration=1"}, "provenance": {"source_ids": ["src:en-wikipedia-org-malabar-matthi-curry"], "transformations": ["extracted:claude-code", "promoted:seed-kerala-fish-curry"], "acquired_on": "2026-09-08", "synthetic": false}, "version": {"revision": 1, "created_on": "2026-09-08", "updated_on": "2026-09-08", "status": "active"}}
{"id": "dish:milagu-rasam", "type": "dish", "schema_version": "2", "labels": ["Milagu rasam", "Pepper rasam"], "content": {"summary": "A rasam heavy on freshly crushed black pepper and cumin, thinner and sharper than the everyday version, traditionally made for someone with a cold or fever.", "serving_context": "Sipped warm, or poured over a small portion of rice."}, "structure": {"category": "rasam", "cuisine_state": "tamil_nadu", "diet": {"vegetarian": true, "vegan": true, "contains_dairy": false, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}, "names": [{"lang": "ta", "native": "மிளகு ரசம்", "transliteration": "milagu rasam", "primary": true}], "variant_of": "dish:rasam", "primary_ingredients": ["ing:black-pepper-whole", "ing:cumin-seeds", "ing:tamarind"], "typical_techniques": ["tech:gentle-simmer", "tech:tadka"]}, "quality": {"confidence": 0.85, "validation_status": "human_validated", "corroboration_count": 1, "notes": "qwen7b:accept; gemma9b:accept; corroboration=1"}, "provenance": {"source_ids": ["src:en-wikipedia-org-rasam-dish"], "transformations": ["extracted:claude-code", "promoted:seed-idli-rasam"], "acquired_on": "2026-09-03", "synthetic": false}, "version": {"revision": 1, "created_on": "2026-09-03", "updated_on": "2026-09-03", "status": "active"}}
{"id": "dish:pesarattu", "type": "dish", "schema_version": "2", "labels": ["Pesarattu", "Pesara attu", "Pesara dosa"], "content": {"summary": "A crepe-like breakfast dish from coastal Andhra Pradesh, a variety of dosa made from a batter of soaked whole green gram ground with green chilli, ginger and salt. Unlike a typical dosa it contains no urad dal and the batter is not fermented — it is used fresh. Cooked crisp-edged on a hot griddle.", "serving_context": "Breakfast or snack, served with ginger chutney (allam pachadi), peanut chutney or tamarind chutney; the upma-stuffed version is upma pesarattu."}, "structure": {"category": "tiffin", "cuisine_state": "andhra_pradesh", "diet": {"vegetarian": true, "vegan": true, "contains_dairy": false, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}, "course": ["breakfast", "tiffin"], "names": [{"lang": "te", "native": "పెసరట్టు", "transliteration": "pesarattu", "primary": true}], "primary_ingredients": ["ing:green-gram-whole", "ing:ginger"], "typical_techniques": ["tech:wet-grind", "tech:griddle-cook"]}, "quality": {"confidence": 0.85, "validation_status": "human_validated", "corroboration_count": 1, "notes": "qwen7b:accept; gemma9b:accept; corroboration=1"}, "provenance": {"source_ids": ["src:en-wikipedia-org-pesarattu"], "transformations": ["extracted:claude-code", "promoted:seed-pesarattu"], "acquired_on": "2026-09-03", "synthetic": false}, "version": {"revision": 1, "created_on": "2026-09-03", "updated_on": "2026-09-03", "status": "active"}}
{"id": "dish:puttu", "type": "dish", "schema_version": "2", "labels": ["Puttu", "Pittu"], "content": {"summary": "Steamed cylinders of coarsely ground rice layered with grated coconut and a little salt, cooked in a two-section puttu kutti vessel. A breakfast dish native to Kerala and Tamil Nadu, with a soft, crumbly texture. Using hot water when mixing the rice improves softness.", "serving_context": "Breakfast, served with kadala (chickpea) curry, ripe banana or plantain, payar thoran and papadum; also with fish or meat curry."}, "structure": {"category": "tiffin", "cuisine_state": "pan_south", "diet": {"vegetarian": true, "vegan": true, "contains_dairy": false, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}, "course": ["breakfast", "tiffin"], "names": [{"lang": "ml", "native": "പുട്ട്", "transliteration": "puttu", "primary": true}, {"lang": "ta", "native": "புட்டு", "transliteration": "puttu"}], "primary_ingredients": ["ing:rice-flour-coarse", "ing:coconut"], "typical_techniques": ["tech:steam"]}, "quality": {"confidence": 0.85, "validation_status": "human_validated", "corroboration_count": 1, "notes": "qwen7b:accept; gemma9b:accept; corroboration=1"}, "provenance": {"source_ids": ["src:en-wikipedia-org-puttu"], "transformations": ["extracted:claude-code", "promoted:seed-puttu"], "acquired_on": "2026-09-03", "synthetic": false}, "version": {"revision": 1, "created_on": "2026-09-03", "updated_on": "2026-09-03", "status": "active"}}
{"id": "dish:rasam", "type": "dish", "schema_version": "2", "labels": ["Rasam", "Saaru", "Charu"], "content": {"summary": "A thin, tangy, peppery South Indian soup of tamarind stock, tomato, dal water and a pepper-cumin spice mix, finished with a mustard tempering.", "serving_context": "Poured over hot rice as a mid-meal course after sambar; also drunk on its own, warm, as a remedy for a cold.", "cultural_notes": "A pepper-heavy rasam (milagu rasam) is a common home remedy when someone is unwell."}, "structure": {"category": "rasam", "cuisine_state": "pan_south", "diet": {"vegetarian": true, "vegan": true, "contains_dairy": false, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}, "course": ["lunch", "accompaniment"], "names": [{"lang": "ta", "native": "ரசம்", "transliteration": "rasam", "primary": true}, {"lang": "ml", "native": "രസം", "transliteration": "rasam"}, {"lang": "kn", "native": "ಸಾರು", "transliteration": "saaru"}, {"lang": "te", "native": "చారు", "transliteration": "charu"}], "primary_ingredients": ["ing:tamarind", "ing:toor-dal", "ing:tomato", "ing:rasam-powder", "ing:black-pepper-whole"], "typical_techniques": ["tech:gentle-simmer", "tech:tadka"]}, "quality": {"confidence": 0.85, "validation_status": "human_validated", "corroboration_count": 1, "notes": "qwen7b:accept; gemma9b:accept; corroboration=1"}, "provenance": {"source_ids": ["src:en-wikipedia-org-rasam-dish"], "transformations": ["extracted:claude-code", "promoted:seed-idli-rasam"], "acquired_on": "2026-09-03", "synthetic": false}, "version": {"revision": 1, "created_on": "2026-09-03", "updated_on": "2026-09-03", "status": "active"}}
{"id": "dish:tomato-rasam", "type": "dish", "schema_version": "2", "labels": ["Tomato rasam", "Thakkali rasam"], "content": {"summary": "A rasam where ripe tomatoes carry most of the tartness, milder and slightly sweet, sometimes made without any tamarind at all."}, "structure": {"category": "rasam", "cuisine_state": "pan_south", "diet": {"vegetarian": true, "vegan": true, "contains_dairy": false, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}, "names": [{"lang": "ta", "native": "தக்காளி ரசம்", "transliteration": "thakkali rasam", "primary": true}], "variant_of": "dish:rasam", "primary_ingredients": ["ing:tomato", "ing:toor-dal", "ing:rasam-powder"], "typical_techniques": ["tech:gentle-simmer", "tech:tadka"]}, "quality": {"confidence": 0.85, "validation_status": "human_validated", "corroboration_count": 1, "notes": "qwen7b:accept; gemma9b:accept; corroboration=1"}, "provenance": {"source_ids": ["src:en-wikipedia-org-rasam-dish"], "transformations": ["extracted:claude-code", "promoted:seed-idli-rasam"], "acquired_on": "2026-09-03", "synthetic": false}, "version": {"revision": 1, "created_on": "2026-09-03", "updated_on": "2026-09-03", "status": "active"}}
{"id": "dish:ven-pongal", "type": "dish", "schema_version": "2", "labels": ["Ven pongal", "Khara pongal", "Ghee pongal"], "content": {"summary": "A soft, savoury Tamil Nadu breakfast of rice and moong dal cooked together and seasoned with a ghee tempering of black pepper, cumin, ginger, curry leaves, cashew and asafoetida.", "description": "'Ven' means white/plain: unlike the sweet sakkarai pongal, ven pongal is seasoned only with pepper and cumin, not chilli or sugar. It is a staple tiffin, a common temple-kitchen dish, and the centrepiece of the Pongal harvest festival meal.", "serving_context": "Breakfast or tiffin, served hot with coconut chutney and sambar or gothsu (a tangy brinjal side).", "cultural_notes": "Frequently cooked in an allium-free temple style. The festival version is cooked outdoors in a clay pot until the milk-and-rice boils over, traditionally regarded as an auspicious sign."}, "structure": {"category": "tiffin", "course": ["breakfast", "tiffin", "festival"], "primary_ingredients": ["ing:rice-raw", "ing:moong-dal", "ing:ghee", "ing:black-pepper-whole", "ing:cumin-seeds"], "typical_techniques": ["tech:dry-roast", "tech:pressure-cook", "tech:tadka"], "regions": ["region:thanjavur"], "expected_outcome_ids": ["outcome:soft-creamy-pongal"], "constraints_typically_met": ["constraint:no-onion-no-garlic"], "variant_of": null, "festival_associations": ["Thai Pongal", "Karthigai"], "names": [{"lang": "ta", "native": "வென் பொங்கல்", "transliteration": "ven pongal", "primary": true}], "cuisine_state": "tamil_nadu", "diet": {"vegetarian": true, "vegan": false, "contains_dairy": true, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}}, "provenance": {"source_ids": ["src:hand-authored-seed"], "acquired_on": "2026-09-02", "transformations": ["hand_authored", "migration:v1_to_v2"], "synthetic": false}, "quality": {"confidence": 0.9, "validation_status": "human_validated", "corroboration_count": 1}, "version": {"revision": 1, "created_on": "2026-09-02", "updated_on": "2026-09-02", "status": "active"}}
