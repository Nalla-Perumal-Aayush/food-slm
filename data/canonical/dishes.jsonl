{"id": "dish:rasam", "type": "dish", "schema_version": "2", "labels": ["Rasam", "Saaru", "Charu"], "content": {"summary": "A thin, tangy, peppery South Indian soup of tamarind stock, tomato, dal water and a pepper-cumin spice mix, finished with a mustard tempering.", "serving_context": "Poured over hot rice as a mid-meal course after sambar; also drunk on its own, warm, as a remedy for a cold.", "cultural_notes": "A pepper-heavy rasam (milagu rasam) is a common home remedy when someone is unwell."}, "structure": {"category": "rasam", "cuisine_state": "pan_south", "diet": {"vegetarian": true, "vegan": true, "contains_dairy": false, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}, "course": ["lunch", "accompaniment"], "names": [{"lang": "ta", "native": "ரசம்", "transliteration": "rasam", "primary": true}, {"lang": "ml", "native": "രസം", "transliteration": "rasam"}, {"lang": "kn", "native": "ಸಾರು", "transliteration": "saaru"}, {"lang": "te", "native": "చారు", "transliteration": "charu"}], "primary_ingredients": ["ing:tamarind", "ing:toor-dal", "ing:tomato", "ing:rasam-powder", "ing:black-pepper-whole"], "typical_techniques": ["tech:gentle-simmer", "tech:tadka"]}, "quality": {"confidence": 0.85, "validation_status": "human_validated", "corroboration_count": 1, "notes": "qwen7b:accept; gemma9b:accept; corroboration=1"}, "provenance": {"source_ids": ["src:en-wikipedia-org-rasam-dish"], "transformations": ["extracted:claude-code", "promoted:seed-idli-rasam"], "acquired_on": "2026-09-03", "synthetic": false}, "version": {"revision": 1, "created_on": "2026-09-03", "updated_on": "2026-09-03", "status": "active"}}
