{"id": "dish:ven-pongal", "type": "dish", "schema_version": "2", "labels": ["Ven pongal", "Khara pongal", "Ghee pongal"], "content": {"summary": "A soft, savoury Tamil Nadu breakfast of rice and moong dal cooked together and seasoned with a ghee tempering of black pepper, cumin, ginger, curry leaves, cashew and asafoetida.", "description": "'Ven' means white/plain: unlike the sweet sakkarai pongal, ven pongal is seasoned only with pepper and cumin, not chilli or sugar. It is a staple tiffin, a common temple-kitchen dish, and the centrepiece of the Pongal harvest festival meal.", "serving_context": "Breakfast or tiffin, served hot with coconut chutney and sambar or gothsu (a tangy brinjal side).", "cultural_notes": "Frequently cooked in an allium-free temple style. The festival version is cooked outdoors in a clay pot until the milk-and-rice boils over, traditionally regarded as an auspicious sign."}, "structure": {"category": "tiffin", "course": ["breakfast", "tiffin", "festival"], "primary_ingredients": ["ing:rice-raw", "ing:moong-dal", "ing:ghee", "ing:black-pepper-whole", "ing:cumin-seeds"], "typical_techniques": ["tech:dry-roast", "tech:pressure-cook", "tech:tadka"], "regions": ["region:thanjavur"], "expected_outcome_ids": ["outcome:soft-creamy-pongal"], "constraints_typically_met": ["constraint:no-onion-no-garlic"], "variant_of": null, "festival_associations": ["Thai Pongal", "Karthigai"], "names": [{"lang": "ta", "native": "வென் பொங்கல்", "transliteration": "ven pongal", "primary": true}], "cuisine_state": "tamil_nadu", "diet": {"vegetarian": true, "vegan": false, "contains_dairy": true, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}}, "provenance": {"source_ids": ["src:hand-authored-seed"], "acquired_on": "2026-09-02", "transformations": ["hand_authored", "migration:v1_to_v2"], "synthetic": false}, "quality": {"confidence": 0.9, "validation_status": "human_validated", "corroboration_count": 1}, "versio