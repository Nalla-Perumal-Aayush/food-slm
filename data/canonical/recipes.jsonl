 and dal lightly. Pour in the tempering with all its ghee and fold through, loosening with a little hot water to a soft dropping consistency.", "action_verb": "combine", "input_ingredient_ids": ["ing:salt"], "input_state_ids": ["state:rice-dal-cooked-soft", "state:tempering-fried"], "output_state_ids": ["state:pongal-final"], "equipment_id": null, "technique_id": null, "params": {"until_condition": "soft, creamy, falls slowly off a spoon"}, "depends_on": ["s3", "s5"], "parallel_ok": false}, {"step_id": "s7", "order": 7, "phase": "serve", "action": "Serve hot straight away, with an extra tsp of ghee on top if you like, alongside coconut chutney and sambar.", "action_verb": "serve", "input_ingredient_ids": [], "input_state_ids": ["state:pongal-final"], "output_state_ids": ["state:pongal-final"], "equipment_id": null, "technique_id": null, "params": {}, "depends_on": ["s6"], "parallel_ok": false}], "states": ["state:moong-dal-roasted", "state:rice-dal-cooked-soft", "state:ghee-hot", "state:tempering-fried", "state:pongal-final"], "outcome_ids": ["outcome:soft-creamy-pongal"], "constraints_met": ["constraint:no-onion-no-garlic"], "scalable": true, "make_ahead": false, "names": [], "cuisine_state": "tamil_nadu", "diet": {"vegetarian": true, "vegan": false, "contains_dairy": true, "contains_egg": false, "contains_seafood": false, "contains_poultry": false, "contains_red_meat": false}}, "provenance": {"source_ids": ["src:hand-authored-seed"], "acquired_on": "2026-09-02", "transformations": ["hand_authored", "migration:v1_to_v2"], "synthetic": false}, "quality": {"confidence": 0.88, "validation_status": "human_validated", "corroboration_count": 1}, "version": {"revision": 1, "created_on": "2026-09-02", "updated_on": "2026-09-02", "status": "active"}}
