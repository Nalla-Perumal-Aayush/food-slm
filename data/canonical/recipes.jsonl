{"id": "recipe:ven-pongal--classic", "type": "recipe", "schema_version": "2", "labels": ["Ven pongal - classic household version"], "content": {"summary": "The everyday Tamil household ven pongal: dal lightly roasted, cooked soft with rice in a pressure cooker, finished with a generous ghee tempering of pepper, cumin, ginger, cashew, curry leaves and asafoetida.", "intro": "This is the plain, temple-safe version - no onion, no garlic, no chilli. The two things that decide success are the water ratio (keep it loose) and a hot, unhurried tempering.", "tips": ["Roast the moong dal only until it smells nutty - colour barely changes.", "Crush the peppercorns lightly so the heat spreads.", "Keep a small cup of hot water aside to loosen the pongal just before serving."], "common_mistakes": ["Too little water - pongal sets hard as it cools.", "Tempering in ghee that is not hot enough - spices go soft and the aroma is flat.", "Serving late - always thickens on standing."], "serving_suggestions": "Serve hot with coconut chutney and either sambar or a tangy brinjal gothsu."}, "structure": {"dish_id": "dish:ven-pongal", "variant_label": "classic household", "yield": {"servings": 3, "quantity": null}, "total_time": {"original_text": "35 minutes", "value": 35.0, "unit": "min", "value_canonical": 35.0, "unit_canonical": "min", "dimension": "time", "approximate": true}, "active_time": {"original_text": "15 minutes", "value": 15.0, "unit": "min", "value_canonical": 15.0, "unit_canonical": "min", "dimension": "time", "approximate": true}, "difficulty": "easy", "ingredients": [{"ingredient_id": "ing:rice-raw", "quantity": {"original_text": "1 cup", "value": 1.0, "unit": "cup", "value_canonical": 240.0, "unit_canonical": "ml", "dimension": "volume", "approximate": false}, "form": "whole", "preparation": "rinsed", "role_in_recipe": "base", "group": "for the pongal"}, {"ingredient_id": "ing:moong-dal", "quantity": {"original_text": "1/4 cup", "value": 0.25, "unit": "cup", "value_canonical": 60.0, "unit_canonical": "ml", "dimension": "volume", "approximate": false}, "form": "split", "preparation": "dry-roasted until aromatic", "role_in_recipe": "base", "group": "for the pongal"}, {"ingredient_id": "ing:water", "quantity": {"original_text": "4.5 cups", "value": 4.5, "unit": "cup", "value_canonical": 1080.0, "unit_canonical": "ml", "dimension": "volume", "approximate": true, "range": [960.0, 1200.0]}, "role_in_recipe": "base", "group": "for the pongal"}, {"ingredient_id": "ing:salt", "quantity": {"original_text": "to taste", "dimension": "qualitative", "qualitative": "to_taste"}, "role_in_recipe": "base", "group": "for the pongal"}, {"ingredient_id": "ing:ghee", "quantity": {"original_text": "3 tbsp", "value": 3.0, "unit": "tbsp", "value_canonical": 45.0, "unit_canonical": "ml", "dimension": "volume", "approximate": false}, "form": "fresh", "role_in_recipe": "fat", "group": "for the tempering"}, {"ingredient_id": "ing:black-pepper-whole", "quantity": {"original_text": "1 tsp", "value": 1.0, "unit": "tsp", "value_canonical": 5.0, "unit_canonical": "ml", "dimension": "volume", "approximate": true}, "form": "whole", "preparation": "lightly crushed", "role_in_recipe": "tempering", "group": "for the tempering"}, {"ingredient_id": "ing:cumin-seeds", "quantity": {"original_text": "1 tsp", "value": 1.0, "unit": "tsp", "value_canonical": 5.0, "unit_canonical": "ml", "dimension": "volume", "approximate": true}, "form": "whole", "role_in_recipe": "tempering", "group": "for the tempering"}, {"ingredient_id": "ing:ginger", "quantity": {"original_text": "1 inch, chopped", "value": 15.0, "unit": "g", "value_canonical": 15.0, "unit_canonical": "g", "dimension": "mass", "approximate": true}, "form": "fresh", "preparation": "finely chopped", "role_in_recipe": "aromatic", "group": "for the tempering"}, {"ingredient_id": "ing:cashew", "quantity": {"original_text": "12 nuts", "value": 12.0, "unit": "count", "value_canonical": 12.0, "unit_canonical": "count", "dimension": "count", "approximate": true}, "form": "whole", "preparation": "halved", "role_in_recipe": "garnish", "group": "for the tempering"}, {"ingredient_id": "ing:curry-leaves", "quantity": {"original_text": "1 sprig", "value": 1.0, "unit": "sprig", "value_canonical": 1.0, "unit_canonical": "count", "dimension": "count", "approximate": true}, "form": "fresh", "role_in_recipe": "aromatic", "group": "for the tempering"}, {"ingredient_id": "ing:asafoetida", "quantity": {"original_text": "1/8 tsp", "value": 0.125, "unit": "tsp", "value_canonical": 0.625, "unit_canonical": "ml", "dimension": "volume", "approximate": true}, "form": "powder", "role_in_recipe": "aromatic", "group": "for the tempering"}], "equipment_ids": ["equip:pressure-cooker", "equip:kadai"], "steps": [{"step_id": "s1", "order": 1, "phase": "prep", "action": "Dry-roast the moong dal in a pan over medium heat until it smells nutty and turns pale gold, about 3 minutes.", "action_verb": "dry_roast", "input_ingredient_ids": ["ing:moong-dal"], "input_state_ids": [], "output_state_ids": ["state:moong-dal-roasted"], "equipment_id": "equip:kadai", "technique_id": "tech:dry-roast", "params": {"heat_level": "medium", "duration": {"original_text": "3 minutes", "value": 3.0, "unit": "min", "value_canonical": 3.0, "unit_canonical": "min", "dimension": "time", "approximate": true}, "until_condition": "nutty aroma, colour barely changed"}, "depends_on": [], "parallel_ok": false}, {"step_id": "s2", "order": 2, "phase": "prep", "action": "Rinse the rice and the roasted dal together in a couple of changes of water and drain.", "action_verb": "rinse", "input_ingredient_ids": ["ing:rice-raw"], "input_state_ids": ["state:moong-dal-roasted"], "output_state_ids": [], "equipment_id": null, "technique_id": null, "params": {}, "depends_on": ["s1"], "parallel_ok": false}, {"step_id": "s3", "order": 3, "phase": "cook", "action": "Add the rinsed rice and dal to the pressure cooker with the water, close, and cook on medium for 4 whistles. L