# --- caches / environments ---
.cache/
.wandb/
wandb/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# --- data: large / regenerable / license-sensitive ---
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep
data/corpus/**
!data/corpus/.gitkeep
data/instruction/**
!data/instruction/.gitkeep

# --- model artifacts ---
artifacts/checkpoints/**
!artifacts/checkpoints/.gitkeep
artifacts/tokenizers/**
!artifacts/tokenizers/.gitkeep
*.pt
*.bin
*.safetensors
*.gguf

# --- misc ---
.env
*.log
# forbidden-entity freeze audit trail IS versioned
!data/eval/forbidden_entities.amendments.log
.DS_Store
Thumbs.db

# --- tracked on purpose ---
# data/canonical/**   (canonical JSONL knowledge store IS versioned)
# data/eval/**        (eval sets + forbidden-entity list ARE versioned)
# Documents/**         (planning docs ARE versioned)

# office temp lock files
~$*.docx
~$*.xlsx

# fasttext langid model — fetched by food_slm.data.langid.ensure_model()
artifacts/models/**
!artifacts/models/.gitkeep
artifacts/watchdog_state.json
artifacts/logs/*
!artifacts/logs/.gitkeep
